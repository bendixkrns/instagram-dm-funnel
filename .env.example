# Copy to ../.env and fill only the services you use. Never commit real values.
INSTAGRAM_FIRMA_ACCESS_TOKEN=
INSTAGRAM_FIRMA_USER_ID=
INSTAGRAM_API_VERSION=v23.0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
ZERNIO_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
GROQ_API_KEY=
# Kommentarquelle: poll (Standard, fragt Meta alle ~30 s ab) | webhook (nur Meta-Ereignisse) | beides (Webhook plus Abfrage als Sicherung)
BOT_KOMMENTARE_QUELLE=poll
BOT_LLM_BACKEND=groq
GROQ_MODEL=openai/gpt-oss-20b
COCKPIT_PORT=5090
COCKPIT_KENNZAHLEN_MINUTEN=30
COCKPIT_KENNZAHLEN_STUNDEN=6
# System-provided variables used by local tools; normally leave unset.
LOCALAPPDATA=
EYES_HOME=
